[Unit]
Description=Tugas Harian
After=network.target

[Service]
User=tugas
WorkingDirectory=/opt/tugas-harian/server
EnvironmentFile=/etc/tugas-harian.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/index.js
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tugas-harian

[Install]
WantedBy=multi-user.target
