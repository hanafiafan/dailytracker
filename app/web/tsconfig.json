{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "node"
    ],
    "paths": {
      "@shared/*": [
        "../shared/src/*"
      ],
      "@server/*": [
        "../server/src/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../shared/src",
    "../server/src/app.ts"
  ],
  "exclude": [
    "src/sw.ts"
  ]
}